---
// /tinkering/[slug] — 折腾日记详情页（Markdown 正文）
import Layout from '../../layouts/Dashboard.astro';
import Prose from '../../components/Prose.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('tinkering');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as any;
const { Content } = await render(post);
const { data } = post;
const d = new Date(data.date);
const dateStr = `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---
<Layout title={`${data.title} — 折腾日记`}>
  <article class="post-wrap">
    <header class="post-head">
      <a class="back" href="/tinkering">← 折腾日记</a>
      <h1 class="hand">{data.title}</h1>
      <div class="meta">
        <span class="meta-date">{dateStr}</span>
        {data.tags && data.tags.length > 0 && (
          <span class="tags">
            {data.tags.map(t => <span class="tag">{t}</span>)}
          </span>
        )}
      </div>
    </header>
    <Prose>
      <Content />
    </Prose>
  </article>
</Layout>

<style>
  .post-wrap { max-width: 820px; margin: 0 auto; }
  .post-head { margin-bottom: 20px; }
  .back { font-size: 0.9rem; color: var(--color-secondary); font-family: var(--font-body); }
  .back:hover { color: var(--color-brand); }
  .post-head h1 { font-size: 2.3rem; color: var(--color-primary); margin: 10px 0 8px; line-height: 1.3; }
  .meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-family: var(--font-body); }
  .meta-date { font-size: 0.85rem; color: var(--color-secondary); }
  .tags { display: flex; gap: 6px; }
  .tag {
    font-size: 0.72rem; padding: 2px 10px; border-radius: 999px;
    background: rgba(53,191,171,.14); color: var(--color-brand);
  }
  @media (max-width: 600px) { .post-head h1 { font-size: 1.8rem; } }
</style>
