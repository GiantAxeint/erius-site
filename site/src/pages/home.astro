---
// /home — Erius 门户 dashboard（v2 改版）
// 布局：左列(用户卡+最新文章) / 中列(问候+联系条带) / 右列(时钟+日历+音乐+回顶)
// 每张卡用 style="--i:N" 控制入场动画的延迟（参考 lvy010 的气泡入场）
import Layout from '../layouts/Dashboard.astro';
import UserCard from '../components/UserCard.astro';
import ContactBar from '../components/ContactBar.astro';
import GreetingCard from '../components/GreetingCard.astro';
import ClockCard from '../components/ClockCard.astro';
import CalendarCard from '../components/CalendarCard.astro';
import LatestPostsCard from '../components/LatestPostsCard.astro';
import MusicPlayerCard from '../components/MusicPlayerCard.astro';
import BackToTop from '../components/BackToTop.astro';
import { profile, menuItems, socialLinks } from '../data/profile';
---
<Layout title="Erius!">
  <div class="dash">
    <aside class="left">
      <div class="bubble" style="--i:0"><UserCard menuItems={menuItems} /></div>
      <div class="bubble" style="--i:3"><LatestPostsCard /></div>
    </aside>
    <main class="center">
      <div class="bubble" style="--i:1"><GreetingCard name={profile.name} intro={profile.intro} /></div>
      <div class="bubble" style="--i:2"><ContactBar links={socialLinks} /></div>
    </main>
    <aside class="right">
      <div class="bubble" style="--i:4"><ClockCard /></div>
      <div class="bubble" style="--i:5"><CalendarCard /></div>
      <div class="bubble" style="--i:6"><MusicPlayerCard /></div>
    </aside>
  </div>
  <BackToTop />
</Layout>

<style>
  /* ===== 栅格 ===== */
  .dash {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    max-width: 1280px;
    margin: 0 auto;
  }
  @media (min-width: 900px) {
    .dash {
      grid-template-columns: 240px 1fr 260px;
      grid-template-areas: "left center right";
      align-items: start;
    }
    .left   { grid-area: left;   display: flex; flex-direction: column; gap: 18px; }
    .center { grid-area: center; display: flex; flex-direction: column; gap: 18px; }
    .right  { grid-area: right;  display: flex; flex-direction: column; gap: 18px; }
  }

  /* ===== 气泡入场动画（参考 lvy010） ===== */
  /* 每张 .bubble 在 home 页加载时缓慢放大并归位，
     通过 inline style --i 控制错落，cubic-bezier(0.34,1.56,0.64,1) 给一点回弹 */
  .bubble {
    opacity: 0;
    transform: translateY(18px) scale(0.7);
    animation: bubbleIn 0.75s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--i, 0) * 0.09s + 0.05s);
  }
  @keyframes bubbleIn {
    0%   { opacity: 0; transform: translateY(22px) scale(0.65); }
    60%  { opacity: 1; transform: translateY(-4px) scale(1.04); }
    100% { opacity: 1; transform: translateY(0)    scale(1); }
  }
  /* 尊重系统"减少动效"偏好 */
  @media (prefers-reduced-motion: reduce) {
    .bubble { animation: none; opacity: 1; transform: none; }
  }
</style>