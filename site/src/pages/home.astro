---
// /home — Erius 门户 dashboard
// 卡片列表：左 UserCard/Social/LatestPosts；中 Greeting；右 Clock/Calendar/Music
// 完整列表（项目/折腾/随笔）去独立页
import Layout from '../layouts/Dashboard.astro';
import UserCard from '../components/UserCard.astro';
import GreetingCard from '../components/GreetingCard.astro';
import ClockCard from '../components/ClockCard.astro';
import CalendarCard from '../components/CalendarCard.astro';
import SocialCard from '../components/SocialCard.astro';
import LatestPostsCard from '../components/LatestPostsCard.astro';
import MusicPlayerCard from '../components/MusicPlayerCard.astro';
import { profile, menuItems, socialLinks } from '../data/profile';
---
<Layout title="Erius!">
  <div class="dash">
    <aside class="left">
      <UserCard menuItems={menuItems} />
      <SocialCard links={socialLinks} />
      <LatestPostsCard />
    </aside>
    <main class="center">
      <GreetingCard name={profile.name} intro={profile.intro} />
    </main>
    <aside class="right">
      <ClockCard />
      <CalendarCard />
      <MusicPlayerCard />
    </aside>
  </div>
</Layout>

<style>
  .dash {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    max-width: 1280px;
    margin: 0 auto;
  }
  @media (min-width: 900px) {
    .dash {
      grid-template-columns: 240px 1fr 260px;
      grid-template-areas: "left center right";
      align-items: start;
    }
    .left  { grid-area: left;   display: flex; flex-direction: column; gap: 18px; }
    .center { grid-area: center; display: flex; flex-direction: column; gap: 18px; }
    .right { grid-area: right;  display: flex; flex-direction: column; gap: 18px; }
  }
  @media (max-width: 899px) {
    .left, .center, .right { display: flex; flex-direction: column; gap: 18px; }
  }

  /* ============================================================
     气泡入场动画 —— 仿 lvyovo-wiki.tech：
     - 每张卡片从较小状态（0.55）放大到位（1），配合下沉→上浮，纵向+透明度同步收口
     - 列到列、卡片到卡片，依次 staggered 入场
     - 缓动用 overshoot（cubic-bezier 带回弹），更"气泡"感
     - 仅在首次渲染时跑一次
     ============================================================ */
  @keyframes bubble-in {
    0%   { transform: scale(.55) translateY(18px); opacity: 0; }
    70%  { transform: scale(1.04) translateY(0);   opacity: 1; }
    100% { transform: scale(1)   translateY(0);   opacity: 1; }
  }
  /* 各列容器本身轻微进入 */
  .dash > .left,
  .dash > .center,
  .dash > .right {
    animation: bubble-in .55s cubic-bezier(.34,1.56,.64,1) both;
  }
  .dash > .left   { animation-delay: .08s; }
  .dash > .center { animation-delay: .16s; }
  .dash > .right  { animation-delay: .24s; }

  /* 各列内卡片 staggered 进入 —— 用 :nth-child 把第 n 张卡片按时间间隔推入 */
  .dash > aside > *,
  .dash > main  > * {
    animation: bubble-in .6s cubic-bezier(.34,1.56,.64,1) both;
  }
  .dash > .left   > *:nth-child(1) { animation-delay: .18s; }
  .dash > .left   > *:nth-child(2) { animation-delay: .30s; }
  .dash > .left   > *:nth-child(3) { animation-delay: .42s; }

  .dash > .center > *:nth-child(1) { animation-delay: .28s; }
  .dash > .center > *:nth-child(2) { animation-delay: .40s; }

  .dash > .right  > *:nth-child(1) { animation-delay: .34s; }
  .dash > .right  > *:nth-child(2) { animation-delay: .46s; }
  .dash > .right  > *:nth-child(3) { animation-delay: .58s; }

  /* 尊重系统的"减少动画"偏好 */
  @media (prefers-reduced-motion: reduce) {
    .dash > .left, .dash > .center, .dash > .right,
    .dash > aside > *, .dash > main > * {
      animation: none;
    }
  }
</style>
