---
// /home — Erius 门户 dashboard（v5：v3b 基线 + 最新 6 条微调）
// 视觉中心：问候大卡"6"（面积 +35% 后仍居中）
// 围绕：LatestPosts(7 在 6 左下对角) + ContactBar 胶囊条(左下贴 6) + Clock/Calendar(右列错峰) + Music 横长条(6 斜右下对角)
import Layout from '../layouts/Dashboard.astro';
import UserCard from '../components/UserCard.astro';
import ContactBar from '../components/ContactBar.astro';
import GreetingCard from '../components/GreetingCard.astro';
import ClockCard from '../components/ClockCard.astro';
import CalendarCard from '../components/CalendarCard.astro';
import LatestPostsCard from '../components/LatestPostsCard.astro';
import MusicPlayerCard from '../components/MusicPlayerCard.astro';
import BackToTop from '../components/BackToTop.astro';
import { profile, menuItems, socialLinks } from '../data/profile';
---
<Layout title="Erius!">
  <div class="stage">
    <div class="dash">
      <div class="bubble cell left-top" style="--i:0">
        <UserCard menuItems={menuItems} />
      </div>
      <div class="bubble cell center-main" style="--i:1">
        <GreetingCard name={profile.name} intro={profile.intro} />
      </div>
      <div class="bubble cell right-top" style="--i:2">
        <ClockCard />
      </div>
      <div class="bubble cell left-mid" style="--i:3">
        <LatestPostsCard />
      </div>
      <div class="bubble cell center-foot" style="--i:4">
        <ContactBar links={socialLinks} />
      </div>
      <div class="bubble cell right-mid" style="--i:5">
        <CalendarCard />
      </div>
      <div class="bubble cell right-foot" style="--i:6">
        <MusicPlayerCard />
      </div>
    </div>
  </div>
  <BackToTop />
</Layout>

<style>
  .stage { max-width: 1280px; margin: 0 auto; }
  .dash {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "main"
      "foot"
      "left"
      "right";
    gap: 18px;
  }
  /* 桌面：以问候卡"6"为视觉锚点，所有周边卡做"以 6 为中心的散乱布局"
     时钟距 6 过远 → 向左平移 6px；
     时钟与日历左右边界错开（不同 margin-left）→ 错峰；
     日历宽高 +25%（在 CalendarCard.astro 内做）+ 向左平移 3px；
     LatestPosts（7）在 6 的左下对角方向 + 距离不远 → 左下偏移靠近 6；
     Music 横长条移至 6 的斜右下对角 + 更靠近；
     ContactBar 胶囊条向左下挪 + 紧贴 6 底沿。 */
  @media (min-width: 960px) {
    .dash {
      grid-template-columns: minmax(200px, 230px) minmax(400px, 500px) minmax(200px, 230px);
      grid-template-areas:
        "left-top    main     right-top"
        "left-mid    main     right-mid"
        "left-foot   foot     right-foot";
      align-items: start;
      column-gap: 22px;
      row-gap: 22px;
    }
    /* 左列：UserCard 与 6 顶对齐；LatestPosts(7) 在 6 的左下对角方向 + 距离不远 */
    .left-top    { margin-top: 0; }
    .left-mid    { margin-top: 36px; }
    /* 中央列底部：ContactBar 胶囊条向左下挪 + 上移贴 6 底沿 */
    .center-foot { margin-top: -40px; margin-left: -16px; }
    /* 右列：时钟向左 6px、日历向左 3px，左右边界错开不垂直对齐 */
    .right-top   { margin-top: 28px; margin-left: 6px; }    /* 时钟：距 6 过远 → 向左 6px */
    .right-mid   { margin-top: 32px; margin-left: -3px; }   /* 日历：向左 3px，与时钟左缘错峰 */
    /* Music 横长条：移至 6 的斜右下对角 + 更靠近 */
    .right-foot  { margin-top: 12px; margin-left: -10px; }
  }

  .center-main { grid-area: main; align-self: center; justify-self: center; width: 100%; max-width: 500px; }
  .center-foot { grid-area: foot; justify-self: flex-start; }
  .left-top    { grid-area: left-top; }
  .left-mid    { grid-area: left-mid; }
  .right-top   { grid-area: right-top; }
  .right-mid   { grid-area: right-mid; }
  .right-foot  { grid-area: right-foot; }

  /* ===== 气泡入场动画 ===== */
  .bubble {
    opacity: 0;
    transform: translateY(18px) scale(0.7);
    animation: bubbleIn 0.75s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--i, 0) * 0.1s + 0.05s);
  }
  @keyframes bubbleIn {
    0%   { opacity: 0; transform: translateY(24px) scale(0.6); }
    60%  { opacity: 1; transform: translateY(-4px) scale(1.05); }
    100% { opacity: 1; transform: translateY(0)    scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble { animation: none; opacity: 1; transform: none; }
  }
</style>