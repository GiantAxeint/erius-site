---
// /home — Erius 门户 dashboard（五功能模块布局，与原初.png 一致）
// 左列：UserCard + Contact(SocialCard)
// 中列：Greeting + AboutCard + 折腾日记预览 + 随笔日记预览 + ProjectsCard
// 右列：ClockCard + CalendarCard + 播放歌曲(docked) + 最新文章(播放器正下方)
// 播放器在主页以"页面内嵌"形态展示（固定不可拖），切到子页自动变右下角悬浮条
import Layout from '../layouts/Dashboard.astro';
import UserCard from '../components/UserCard.astro';
import GreetingCard from '../components/GreetingCard.astro';
import AboutCard from '../components/AboutCard.astro';
import ClockCard from '../components/ClockCard.astro';
import CalendarCard from '../components/CalendarCard.astro';
import ProjectsCard from '../components/ProjectsCard.astro';
import SocialCard from '../components/SocialCard.astro';
import LatestPostsCard from '../components/LatestPostsCard.astro';
import MusicPlayerCard from '../components/MusicPlayerCard.astro';
import { getCollection } from 'astro:content';
import { profile, menuItems, projects, socialLinks } from '../data/profile';

// 最新折腾日记 + 随笔（各取最新 2 篇预览）
const [tinkering, journal] = await Promise.all([
  getCollection('tinkering'),
  getCollection('journal'),
]);
const latestTinkering = tinkering.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
const latestJournal = journal.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);

function fmtDate(d: Date): string {
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
}
---
<Layout title="Erius!">
  <div class="dash">
    <aside class="left">
      <UserCard menuItems={menuItems} />
      <SocialCard links={socialLinks} />
    </aside>
    <main class="center">
      <GreetingCard name={profile.name} intro={profile.intro} />
      <AboutCard />
      <!-- 折腾日记最新 -->
      <section class="card feed">
        <div class="feed-head">
          <h3 class="card-title hand">折腾日记</h3>
          <a class="feed-more" href="/tinkering">全部 →</a>
        </div>
        {latestTinkering.length > 0 ? (
          <ul class="feed-list">
            {latestTinkering.map(p => (
              <li class="feed-item">
                <a class="feed-title" href={`/tinkering/${p.id}`}>{p.data.title}</a>
                <span class="feed-date">{fmtDate(p.data.date)}</span>
              </li>
            ))}
          </ul>
        ) : <p class="feed-empty">还没有折腾日记</p>}
      </section>
      <!-- 随笔日记最新 -->
      <section class="card feed">
        <div class="feed-head">
          <h3 class="card-title hand">随笔日记</h3>
          <a class="feed-more" href="/journal">全部 →</a>
        </div>
        {latestJournal.length > 0 ? (
          <ul class="feed-list">
            {latestJournal.map(p => (
              <li class="feed-item">
                <a class="feed-title" href={`/journal/${p.id}`}>{p.data.title}</a>
                <span class="feed-date">{fmtDate(p.data.date)}</span>
              </li>
            ))}
          </ul>
        ) : <p class="feed-empty">还没有随笔日记</p>}
      </section>
      <ProjectsCard items={projects} />
    </main>
    <aside class="right">
      <ClockCard />
      <CalendarCard />
      <!-- 播放歌曲模块：主页内嵌形态（固定、不可拖）；子页自动变悬浮 -->
      <MusicPlayerCard mode="docked" />
      <!-- 最新文章：播放歌曲模块正下方 -->
      <LatestPostsCard />
    </aside>
  </div>
</Layout>

<style>
  .dash {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    max-width: 1280px;
    margin: 0 auto;
  }
  @media (min-width: 900px) {
    .dash {
      grid-template-columns: 240px 1fr 260px;
      grid-template-areas: "left center right";
      align-items: start;
    }
    .left { grid-area: left; display: flex; flex-direction: column; gap: 18px; }
    .center { grid-area: center; display: flex; flex-direction: column; gap: 18px; }
    .right { grid-area: right; display: flex; flex-direction: column; gap: 18px; }
  }
  @media (max-width: 899px) {
    .left, .center, .right { display: flex; flex-direction: column; gap: 18px; }
  }

  .feed-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10px; }
  .card-title { font-size: 1.3rem; color: var(--color-primary); }
  .feed-more { font-size: 0.85rem; color: var(--color-brand); }
  .feed-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .feed-item { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .feed-title { color: var(--color-primary); font-size: 0.98rem; }
  .feed-title:hover { color: var(--color-brand); }
  .feed-date { font-size: 0.78rem; color: var(--color-secondary); white-space: nowrap; font-family: var(--font-body); }
  .feed-empty { color: var(--color-secondary); font-size: 0.9rem; }

  /* 播放歌曲(docked) 与 最新文章 之间的间距对齐微调（需求6） */
  .right > :global(.mp.docked) { margin-bottom: 0; }
  .right > :global(.card.latest) { margin-top: 0; }

  /* ============================================================
     气泡入场动画 —— 仿 lvyovo-wiki.tech（刷新 / 导航进入时跑）
     ============================================================ */
  @keyframes bubble-in {
    0%   { transform: scale(.55) translateY(18px); opacity: 0; }
    70%  { transform: scale(1.04) translateY(0);   opacity: 1; }
    100% { transform: scale(1)   translateY(0);   opacity: 1; }
  }
  .dash > .left,
  .dash > .center,
  .dash > .right {
    animation: bubble-in .55s cubic-bezier(.34,1.56,.64,1) both;
  }
  .dash > .left   { animation-delay: .08s; }
  .dash > .center { animation-delay: .16s; }
  .dash > .right  { animation-delay: .24s; }

  .dash > aside > *,
  .dash > main  > * {
    animation: bubble-in .6s cubic-bezier(.34,1.56,.64,1) both;
  }
  .dash > .left   > *:nth-child(1) { animation-delay: .18s; }
  .dash > .left   > *:nth-child(2) { animation-delay: .30s; }

  .dash > .center > *:nth-child(1) { animation-delay: .28s; }
  .dash > .center > *:nth-child(2) { animation-delay: .40s; }
  .dash > .center > *:nth-child(3) { animation-delay: .52s; }
  .dash > .center > *:nth-child(4) { animation-delay: .64s; }
  .dash > .center > *:nth-child(5) { animation-delay: .76s; }

  .dash > .right  > *:nth-child(1) { animation-delay: .34s; }
  .dash > .right  > *:nth-child(2) { animation-delay: .46s; }
  .dash > .right  > *:nth-child(3) { animation-delay: .58s; }
  .dash > .right  > *:nth-child(4) { animation-delay: .70s; }

  @media (prefers-reduced-motion: reduce) {
    .dash > .left, .dash > .center, .dash > .right,
    .dash > aside > *, .dash > main > * {
      animation: none;
    }
  }
</style>
