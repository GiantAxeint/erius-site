---
// 最新文章卡片
// 聚合 tinkering + journal 两个 collection，按 date 倒序，取最近 N 篇
// 每张卡片可显示封面图：frontmatter 加 cover 字段即可（路径 /covers/xxx.webp 等）
import { getCollection } from 'astro:content';
const tinkering = await getCollection('tinkering');
const journal = await getCollection('journal');
const merged = [...tinkering, ...journal]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

function fmt(d: Date) {
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;
}
---
<div class="card latest">
  <h3 class="card-title hand">最新文章</h3>
  <ul class="grid">
    {merged.map(p => (
      <li class="post">
        <a class="post-link" href={`/${p.collection}/${p.id}`}>
          <div class="cover">
            {p.data.cover
              ? <img src={p.data.cover} alt={p.data.title} loading="lazy" />
              : <span class="placeholder hand">{p.data.title.slice(0, 1)}</span>}
          </div>
          <div class="info">
            <span class={`kind kind-${p.collection}`}>{p.collection === 'tinkering' ? '折腾' : '随笔'}</span>
            <span class="title">{p.data.title}</span>
            <span class="meta">{fmt(p.data.date)}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .card-title { font-size: 1.3rem; margin-bottom: 12px; color: var(--color-primary); }
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .post-link {
    display: flex; flex-direction: column;
    border-radius: 12px;
    background: rgba(255,255,255,.45);
    overflow: hidden;
    transition: transform .18s, background .18s;
    color: inherit;
  }
  .post-link:hover {
    background: rgba(53,191,171,.12);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .cover {
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, rgba(53,191,171,.22), rgba(31,201,231,.18));
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .placeholder {
    font-size: 2.4rem; color: var(--color-brand); font-family: var(--font-hand);
  }
  .info { padding: 8px 10px; display: flex; flex-direction: column; gap: 3px; }
  .kind {
    font-size: 0.7rem; padding: 1px 7px; border-radius: 999px; align-self: flex-start;
    background: rgba(53,191,171,.18); color: var(--color-brand);
  }
  .kind-journal { background: rgba(31,201,231,.18); color: #1fc9e7; }
  .title {
    font-size: 0.92rem; color: var(--color-primary); font-weight: 600;
    line-height: 1.35;
    /* 限两行 */
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta { font-size: 0.75rem; color: var(--color-secondary); }
</style>