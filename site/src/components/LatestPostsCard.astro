---
// 最新文章（仅最新 1 篇，紧凑型）
import { getCollection } from 'astro:content';
const [tinkering, journal] = await Promise.all([
  getCollection('tinkering'),
  getCollection('journal'),
]);
const latest = [...tinkering, ...journal]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

function fmt(d: Date) {
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
}
---
{latest && (
  <div class="card latest">
    <h3 class="card-title hand">最新文章</h3>
    <a class="post" href={`/${latest.collection}/${latest.id}`}>
      <span class={`kind kind-${latest.collection}`}>
        {latest.collection === 'tinkering' ? '折腾' : '随笔'}
      </span>
      <span class="title">{latest.data.title}</span>
      <span class="meta">{fmt(latest.data.date)}</span>
    </a>
  </div>
)}

<style>
  .card-title { font-size: 1.2rem; margin-bottom: 10px; color: var(--color-primary); }
  .post {
    display: flex; flex-direction: column; gap: 4px;
    padding: 10px 12px; border-radius: 12px;
    background: rgba(255,255,255,.45);
    transition: background .18s;
    color: inherit;
  }
  .post:hover { background: rgba(53,191,171,.12); text-decoration: none; }
  .kind {
    font-size: 0.68rem; padding: 1px 7px; border-radius: 999px; align-self: flex-start;
    background: rgba(53,191,171,.18); color: var(--color-brand);
  }
  .kind-journal { background: rgba(31,201,231,.18); color: #1fc9e7; }
  .title {
    font-size: 0.95rem; color: var(--color-primary); font-weight: 600;
    line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta { font-size: 0.75rem; color: var(--color-secondary); }
</style>