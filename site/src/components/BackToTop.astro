---
// 回顶按钮：右下角浮动圆（home 页右下 9 号位）
// 仅在文档有滚动量时显示，点击平滑回顶
---
<button id="back-to-top" class="btt" title="回到顶部" aria-label="回到顶部">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
       stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="18 15 12 9 6 15" />
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top') as HTMLButtonElement | null;
  if (btn) {
    const onScroll = () => {
      if (window.scrollY > 240) btn.classList.add('show');
      else btn.classList.remove('show');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style>
  .btt {
    position: fixed; right: 22px; bottom: 22px; z-index: 50;
    width: 44px; height: 44px; border-radius: 50%;
    border: none; cursor: pointer;
    background: var(--color-brand); color: #fff;
    box-shadow: 0 6px 20px rgba(53,191,171,.35);
    display: inline-flex; align-items: center; justify-content: center;
    opacity: 0; transform: translateY(12px) scale(.9);
    pointer-events: none;
    transition: opacity .25s, transform .25s, background .18s;
  }
  .btt.show { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
  .btt:hover { background: var(--color-brand-secondary); }
</style>