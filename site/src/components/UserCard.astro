---
// 用户卡：头像 + 名字 + 简介 + 侧边菜单
// 菜单指向独立页（/posts /projects /about），进入对应页自动高亮
import { profile } from '../data/profile';
import type { MenuItem } from '../data/profile';
interface Props { menuItems: MenuItem[]; }
const { menuItems } = Astro.props;
const path = Astro.url.pathname;
---
<div class="card user">
  {
    profile.avatarImage
      ? <img class="avatar img" src={profile.avatarImage} alt={profile.name} />
      : <div class="avatar text">{profile.avatarText}</div>
  }
  <div class="name hand">{profile.name}</div>
  <div class="tag">{profile.tagline}</div>
  <nav class="menu">
    {menuItems.map(item => (
      // 当前所在页高亮（pathname 匹配菜单 href）
      <a
        href={item.href}
        data-menu={item.key}
        class:list={[{ active: path.startsWith(item.href) }]}
      >{item.label}</a>
    ))}
  </nav>
</div>

<style>
  .user { text-align: center; }
  .avatar {
    width: 64px; height: 64px; border-radius: 50%;
    margin: 0 auto 10px;
    object-fit: cover;
  }
  .avatar.text {
    background: var(--color-brand); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-hand); font-size: 2rem;
  }
  .avatar.img {
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }
  .name { font-size: 1.7rem; margin-bottom: 4px; }
  .tag { font-size: 0.85rem; color: var(--color-secondary); line-height: 1.4; margin-bottom: 16px; }
  .menu { display: flex; flex-direction: column; gap: 4px; }
  .menu a {
    padding: 7px 10px; border-radius: 8px; font-size: 0.95rem;
    color: var(--color-primary); text-align: left;
  }
  .menu a:hover { background: rgba(53,191,171,.12); text-decoration: none; }
  .menu a.active {
    background: rgba(53,191,171,.15);
    color: var(--color-brand);
    font-weight: 600;
  }
</style>
