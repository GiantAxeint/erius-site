---
// 问候卡：方正主卡，页面视觉中心
interface Props { name: string; intro: string; }
const { name, intro } = Astro.props;
---
<div class="card greet">
  <p class="hello hand" id="greet-phrase">Hello</p>
  <h1 class="hand name">I'm {name}</h1>
  <p class="intro">{intro}</p>
  <div class="deco deco-1"></div>
  <div class="deco deco-2"></div>
</div>

<script>
  const el = document.getElementById('greet-phrase');
  if (el) {
    const h = new Date().getHours();
    el.textContent = h < 6 ? 'Good Night' : h < 12 ? 'Good Morning' : h < 18 ? 'Good Afternoon' : 'Good Evening';
  }
</script>

<style>
  .greet {
    position: relative;
    text-align: center;
    padding: 50px 36px;
    /* 方正主卡：品牌渐变 + 白字，观感成为页面重心。
       本轮：面积 +35%（padding 50/36 + min-height 360） */
    background: linear-gradient(135deg, #35bfab 0%, #2ba3c9 100%);
    border: none;
    color: #fff;
    border-radius: 24px;
    box-shadow: 0 12px 32px rgba(53, 191, 171, 0.28);
    overflow: hidden;
    min-height: 360px;
  }
  .greet .hello {
    color: rgba(255,255,255,.85);
    font-size: 1.5rem;
    margin-bottom: 8px;
  }
  .greet h1 { color: #fff; font-size: 3.1rem; margin-bottom: 12px; }
  .greet .intro {
    color: rgba(255,255,255,.9);
    font-size: 1.05rem;
  }
  /* 点缀：低透明度圆，呼应气泡动效 */
  .deco { position: absolute; border-radius: 50%; pointer-events: none; }
  .deco-1 {
    width: 110px; height: 110px; right: -28px; top: -28px;
    background: rgba(255,255,255,.14);
  }
  .deco-2 {
    width: 64px; height: 64px; left: -18px; bottom: -18px;
    background: rgba(255,255,255,.10);
  }
  /* 卡片内文字取白色 → 覆盖 .hand 的 primary 色 */
  .hand { color: inherit; }
</style>