---
// 问候卡：方正主卡，页面视觉中心
// 布局（自上而下）：
//   1. 动态时段问候语（顶部小字）
//   2. "Hi！I'm Erius"（中间最大字）
//   3. "Regain lost courage!"（底部中等字）
interface Props { name: string; intro: string; }
const { name, intro } = Astro.props;
---
<div class="card greet">
  <p class="hello hand" id="greet-phrase">Good morning</p>
  <h1 class="hand name">Hi！I'm {name}</h1>
  <p class="intro">{intro}</p>
  <div class="deco deco-1"></div>
  <div class="deco deco-2"></div>
</div>

<script is:inline>
  // ============================================================
  // 时段映射（用户定义）：
  //   05:00-11:59 → good morning
  //   12:00-13:59 → good noon       （正午时段）
  //   14:00-17:59 → good afternoon
  //   18:00-04:59 → good evening
  // 文案全小写；切换逻辑每分钟跑一次以应对跨时段边界。
  // View Transitions 下必须挂 astro:page-load，每次导航都重跑。
  // ============================================================
  function bootGreet() {
    const el = document.getElementById('greet-phrase');
    if (!el) return;
    function pickGreeting(h) {
      if (h >= 5  && h < 12) return 'Good morning';
      if (h >= 12 && h < 14) return 'Good noon';
      if (h >= 14 && h < 18) return 'Good afternoon';
      return 'Good evening';   // 18..23 与 0..4
    }
    function refresh() { el.textContent = pickGreeting(new Date().getHours()); }
    refresh();
    if (window.__eriusGreetTimer) clearInterval(window.__eriusGreetTimer);
    window.__eriusGreetTimer = setInterval(refresh, 60 * 1000);
  }
  bootGreet();
  document.addEventListener('astro:page-load', bootGreet);
</script>

<style>
  .greet {
    position: relative;
    text-align: center;
    padding: 44px 30px;
    background: linear-gradient(135deg, #35bfab 0%, #2ba3c9 100%);
    border: none;
    color: #fff;
    border-radius: 24px;
    box-shadow: 0 12px 32px rgba(53, 191, 171, 0.28);
    overflow: hidden;
  }
  /* 顶层（动态问候语）：与底层同字号 1.5rem */
  .greet .hello {
    color: rgba(255,255,255,.85);
    font-size: 1.5rem;            /* 与 intro 一致 */
    margin-bottom: 6px;
  }
  /* 中间层（Hi！I'm Erius）：最大字 3.0rem */
  .greet h1 {
    color: #fff;
    font-size: 3.0rem;            /* 页面视觉重心 */
    margin-bottom: 10px;
    white-space: nowrap;
  }
  /* 底层（Regain lost courage!）：与顶层同字号 1.5rem */
  .greet .intro {
    color: rgba(255,255,255,.92);
    font-size: 1.5rem;
  }
  /* 点缀：低透明度圆 */
  .deco { position: absolute; border-radius: 50%; pointer-events: none; }
  .deco-1 {
    width: 110px; height: 110px; right: -28px; top: -28px;
    background: rgba(255,255,255,.14);
  }
  .deco-2 {
    width: 64px; height: 64px; left: -18px; bottom: -18px;
    background: rgba(255,255,255,.10);
  }
  /* 卡片内文字取白色 → 覆盖 .hand 的 primary 色 */
  .hand { color: inherit; }

  /* ---------- 响应式：窄屏阶梯降字号，保持三段同轴居中、不折行 ---------- */
  @media (max-width: 560px) {
    .greet { padding: 34px 20px; }
    .greet h1 { font-size: 2.4rem; }        /* 3.0 → 2.4 */
    .greet .hello, .greet .intro { font-size: 1.15rem; }  /* 1.5 → 1.15 */
  }
  @media (max-width: 360px) {
    .greet { padding: 28px 14px; }
    .greet h1 { font-size: 2.0rem; }        /* 2.4 → 2.0 */
    .greet .hello, .greet .intro { font-size: 1.0rem; }
  }
</style>