---
// 关于我卡片（菜单 #about 锚点目标）
import { aboutContent } from '../data/profile';
---
<div class="card" id="about">
  <h3 class="card-title hand">{aboutContent.heading}</h3>
  {aboutContent.paragraphs.map(p => <p class="para">{p}</p>)}
</div>

<style>
  .card-title { font-size: 1.3rem; margin-bottom: 10px; color: var(--color-primary); }
  .para { font-size: 0.92rem; color: var(--color-secondary); line-height: 1.7; margin-bottom: 8px; }
  .para:last-child { margin-bottom: 0; }
</style>
