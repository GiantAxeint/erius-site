---
// Contact 横向条带：邮箱用 ✉，其余用官方品牌 logo（内联 SVG，零外部资源）
import type { SocialLink } from '../data/profile';
interface Props { links: SocialLink[]; }
const { links } = Astro.props;
// 过滤掉 Home（Home 用单独的 ⌂ 字符 + 角标不强求 logo）
const items = links.filter(l => l.label !== 'Home');
---
<div class="card contact-bar">
  <h3 class="card-title hand">Contact</h3>
  <div class="links">
    {items.map(l => (
      <a class="link" href={l.url} target={l.url.startsWith('http') ? '_blank' : undefined} rel="noopener" title={l.label}>
        {l.label === 'Email' && <span class="icon-char">✉</span>}
        {l.label === 'GitHub' && (
          <svg class="icon-svg" viewBox="0 0 24 24" fill="#1f2328" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17.91-.25 1.89-.38 2.86-.39.97 0 1.95.13 2.86.39 2.18-1.48 3.14-1.17 3.14-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.35.78 1.04.78 2.1v3.11c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
          </svg>
        )}
        {l.label === 'LeetCode' && (
          <svg class="icon-svg lc" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#ffa116" d="M13.48 1.6 7.36 7.72a2 2 0 0 0 0 2.83l1.06 1.06a2 2 0 0 0 2.83 0l6.12-6.12a2 2 0 0 0 0-2.83L16.31 1.6a2 2 0 0 0-2.83 0z"/>
            <path fill="#1f2328" d="M3.81 9.18a2 2 0 0 0-2.83 2.83L7.1 18.13a4 4 0 0 0 5.66 0l4.24-4.24a2 2 0 0 0-2.83-2.83l-3.54 3.54-6.82-6.82z"/>
            <path fill="#ffa116" d="M22.83 16.77a2 2 0 0 0-2.83-2.83l-3.54 3.54-2.12-2.12a2 2 0 0 0-2.83 2.83l3.54 3.54a4 4 0 0 0 5.66 0l2.12-2.12z"/>
          </svg>
        )}
        <span class="label">{l.label}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .card-title { font-size: 1.3rem; margin-bottom: 10px; color: var(--color-primary); }
  .links {
    display: flex; flex-wrap: wrap; gap: 8px;
    justify-content: center;
  }
  .link {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border-radius: 999px;
    background: rgba(255,255,255,.5); color: var(--color-primary);
    font-size: 0.92rem;
    transition: background .15s, transform .15s;
  }
  .link:hover {
    background: rgba(53,191,171,.18);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .icon-char { font-size: 1.15rem; color: var(--color-brand); line-height: 1; }
  .icon-svg { width: 18px; height: 18px; flex-shrink: 0; }
  .label { font-weight: 500; }
  @media (max-width: 700px) {
    .links { justify-content: flex-start; }
  }
</style>