---
// 社交图标格：无标题，各链接独立小格（图标悬停显示名字）
import type { SocialLink } from '../data/profile';
interface Props { links: SocialLink[]; }
const { links } = Astro.props;
const items = links.filter(l => l.label !== 'Home');
---
<div class="social-chips" aria-label="社交链接">
  {items.map(l => (
    <a
      class="chip"
      href={l.url}
      target={l.url.startsWith('http') ? '_blank' : undefined}
      rel="noopener"
      title={l.label}
    >
      {l.label === 'Email' && <span class="c-char">✉</span>}
      {l.label === 'GitHub' && (
        <svg class="c-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17.91-.25 1.89-.38 2.86-.39.97 0 1.95.13 2.86.39 2.18-1.48 3.14-1.17 3.14-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.35.78 1.04.78 2.1v3.11c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
        </svg>
      )}
      {l.label === 'LeetCode' && (
        <svg class="c-svg" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#ffa116" d="M13.48 1.6 7.36 7.72a2 2 0 0 0 0 2.83l1.06 1.06a2 2 0 0 0 2.83 0l6.12-6.12a2 2 0 0 0 0-2.83L16.31 1.6a2 2 0 0 0-2.83 0z"/>
          <path fill="#1f2328" d="M3.81 9.18a2 2 0 0 0-2.83 2.83L7.1 18.13a4 4 0 0 0 5.66 0l4.24-4.24a2 2 0 0 0-2.83-2.83l-3.54 3.54-6.82-6.82z"/>
          <path fill="#ffa116" d="M22.83 16.77a2 2 0 0 0-2.83-2.83l-3.54 3.54-2.12-2.12a2 2 0 0 0-2.83 2.83l3.54 3.54a4 4 0 0 0 5.66 0l2.12-2.12z"/>
        </svg>
      )}
      <span class="c-label">{l.label}</span>
    </a>
  ))}
</div>

<style>
  /* 小格：圆角方块 + 品牌描边，悬停浮起变实 */
  .social-chips {
    display: flex; flex-wrap: wrap; gap: 10px;
    justify-content: center;
  }
  .chip {
    position: relative;
    display: inline-flex; align-items: center; justify-content: center;
    /* 胶囊形：更宽更长，紧贴问候卡下沿 */
    min-width: 64px; height: 36px; padding: 0 16px;
    border-radius: 999px;
    background: rgba(255,255,255,.6);
    border: 1px solid rgba(53,191,.25);
    color: var(--color-primary);
    box-shadow: 0 2px 10px rgba(51,79,82,.07);
    transition: transform .18s, background .18s, border-color .18s;
    gap: 6px;
  }
  .chip:hover {
    transform: translateY(-3px) scale(1.06);
    background: rgba(53,191,171,.15);
    border-color: var(--color-brand);
    text-decoration: none;
  }
  .c-char { font-size: 1.15rem; color: var(--color-brand); line-height: 1; }
  .c-svg { width: 24px; height: 24px; }
  /* 名字：默认与图标横向并排（胶囊形自带文字感），悬停时微调样式 */
  .c-label {
    font-size: 0.82rem; color: var(--color-primary);
    font-weight: 600; letter-spacing: .2px;
    transition: opacity .15s;
    white-space: nowrap;
  }
  @media (max-width: 700px) {
    .social-chips { justify-content: flex-start; }
  }
</style>