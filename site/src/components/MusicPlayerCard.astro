---
// ============================================================
// MusicPlayerCard.astro —— 全局播放器（支持 docked / float 两种形态）
// ============================================================
// 用法：
//   <MusicPlayerCard mode="docked" />  // 主页：嵌入页面流（右列），固定不可拖
//   <MusicPlayerCard mode="float"  />  // 子页：fixed 右下角悬浮，可拖拽移动、可右下角手柄缩放
// ============================================================
// 播放架构（切子页面不断播的关键）：
//   - audio 元素是"全局常驻"的，由 layouts/Dashboard.astro 注入：
//     <audio id="erius-audio" ... transition:persist="erius-audio" />
//     该元素在 View Transitions 换页时被保留（transition:persist），歌曲不中断。
//   - 本组件只负责"UI + 控制逻辑"，每次导航后重新渲染并从全局 audio 恢复状态。
//     因此主页卡（docked）切到子页悬浮条（float）时，播放进度无缝延续。
// ============================================================
// 歌曲放置：site/public/music/ 下放 .mp3/.m4a/.ogg/.wav/.aac/.flac
//   文件名（不含扩展名）= 歌名；build 时自动扫描列表注入页面。
//   本地完整路径：site/public/music/（GitHub 仓库同目录）
// ============================================================
import { readdirSync, existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  mode?: 'docked' | 'float';
}
const { mode = 'float' } = Astro.props;
const isFloat = mode === 'float';

const musicDir = join(process.cwd(), 'public', 'music');
const exts = /\.(mp3|m4a|ogg|wav|aac|flac)$/i;
const raw = existsSync(musicDir) ? readdirSync(musicDir).filter(f => exts.test(f)).sort() : [];
const songs = raw.map(f => ({ file: `/music/${f}`, name: f.replace(exts, '') }));
---
{
  songs.length === 0 ? (
    <p class="card empty">把音频放进 <code>site/public/music/</code> 后重新部署</p>
  ) : (
    <div
      class:list={['mp', 'card', { float: isFloat, docked: !isFloat }]}
      data-mode={mode}
      data-songs={JSON.stringify(songs)}
      id="mp-ui"
    >
      {/* 顶部行：状态点 + 当前歌曲名 + 时间（float 形态右侧带拖拽手柄） */}
      <div class="mp-head">
        <span class="dot" aria-hidden="true"></span>
        <span class="name" data-role="name">—</span>
        <span class="time" data-role="time">0:00 / 0:00</span>
        {isFloat && <span class="grip" data-role="grip" title="拖拽移动">⠿</span>}
      </div>
      {/* 中部：实时进度条 */}
      <input
        class="seek"
        type="range"
        data-role="seek"
        min="0" max="1000" value="0" step="1"
        title="播放进度"
      />
      {/* 底部：上一首 / 暂停-播放 / 下一首 */}
      <div class="ctrl">
        <button class="btn" type="button" data-role="prev" aria-label="上一首" title="上一首">⏮</button>
        <button class="btn play" type="button" data-role="play" aria-label="播放或暂停" title="播放 / 暂停">▶</button>
        <button class="btn" type="button" data-role="next" aria-label="下一首" title="下一首">⏭</button>
      </div>
      {isFloat && <span class="rz" data-role="resize" title="拖拽调整大小"></span>}
    </div>
  )
}

<style>
  /* ---------- 通用外观（两种形态一致） ---------- */
  .mp {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    aspect-ratio: 1 / 0.6;              /* ★ 需求3：宽:高 = 1:0.6 */
    width: 100%;
    padding: 12px 16px;
    user-select: none;
    color: var(--color-primary);
    font-family: var(--font-body);
  }
  .mp * { box-sizing: border-box; }

  .mp-head { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-brand);
    box-shadow: 0 0 0 4px rgba(53,191,171,.18);
    flex: 0 0 auto;
    animation: pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(53,191,171,.18); }
    50%      { box-shadow: 0 0 0 9px rgba(53,191,171,0); }
  }
  .name {
    flex: 0 1 auto; min-width: 0;
    font-weight: 600; font-size: 0.92rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .time {
    margin-left: auto;
    font-size: 0.72rem; color: var(--color-secondary);
    white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .seek {
    width: 100%;
    accent-color: var(--color-brand);
    height: 4px; cursor: pointer;
  }
  .ctrl { display: flex; align-items: center; justify-content: center; gap: 10px; }
  .btn {
    width: 26px; height: 26px; border-radius: 50%;
    border: 1px solid rgba(53,191,171,.35);
    background: rgba(255,255,255,.6);
    cursor: pointer; font-size: 0.7rem; line-height: 1;
    color: var(--color-primary);
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0;
    transition: background .15s, transform .12s;
  }
  .btn:hover { background: rgba(53,191,171,.18); }
  .btn:active { transform: scale(.92); }
  .btn.play {
    background: var(--color-brand); color: #fff; border-color: var(--color-brand);
    width: 30px; height: 30px; font-size: 0.8rem;
  }
  .btn.play:hover { background: var(--color-brand-secondary); border-color: var(--color-brand-secondary); }

  .empty {
    color: var(--color-secondary); font-size: .8rem; line-height: 1.6; text-align: center;
  }
  .empty code {
    background: rgba(53,191,171,.14); color: var(--color-brand);
    padding: 1px 6px; border-radius: 4px; font-size: .85em;
  }

  /* ---------- docked：主页内嵌（固定不拖） ---------- */
  .docked .grip, .docked .rz { display: none; }

  /* ---------- float：子页 fixed 右下角悬浮（可拖、可缩放） ---------- */
  .mp.float {
    position: fixed;
    z-index: 9999;
    width: 240px;
    left: calc(100vw - 240px - 22px);
    top: calc(100vh - 144px - 22px);
    background: rgba(255,255,255,.94);
    box-shadow: 0 8px 28px rgba(51,79,82,.22);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 12px 14px;
    font-size: .9rem;
  }
  .grip {
    flex: 0 0 auto;
    color: var(--color-secondary);
    font-size: .95rem; letter-spacing: -2px;
    cursor: grab;
    padding: 0 2px;
    line-height: 1;
  }
  .grip:active { cursor: grabbing; }
  .rz {
    position: absolute;
    right: 3px; bottom: 3px;
    width: 16px; height: 16px;
    cursor: nwse-resize;
    opacity: .45;
    background:
      linear-gradient(135deg, transparent 0 50%, var(--color-secondary) 50% 58%, transparent 58% 100%) no-repeat right bottom / 12px 12px;
  }
  .rz:hover { opacity: 1; }
</style>

<script is:inline>
  // ============================================================
  // 全局播放逻辑 v3（2026-09-07 重构）
  // 修复的三个 bug 及其根因：
  //   A. 播放/暂停按钮"无响应"：bootPlayer 初次执行 + astro:page-load
  //      在同一 DOM 上跑两次 → click 被绑两次。一次点击 = pause 后立刻
  //      被第二个 handler play() 覆盖 → 肉眼可见"暂停无效"。
  //      修复：模块级状态 window.__eriusMP + boot 守卫（同一 DOM 只初始化一次）。
  //   B. audio 跨页常驻 → 每次导航都给同一 audio 重复 addEventListener，
  //      监听器无限累积。修复：audio 事件只绑一次（S.bound 守卫），
  //      通过"当前活跃 UI 指针"S.ui 操作最新 DOM。
  //   C. 切歌可能重播当前歌：audio.src 是百分号编码的绝对 URL
  //      （如 .../music/%E6%A2%A6.mp3），与 songs[].file 的原始中文名
  //      endsWith 永远失配 → idx 恒 -1 → 随机切歌不排除当前。
  //      修复：统一按 decodeURIComponent 后的 basename 匹配。
  // ============================================================
  (function () {
    var S = window.__eriusMP = window.__eriusMP || { bound: false, ui: null, songs: [], idx: -1, audio: null, reqToken: 0 };

    function ensureAudio() {
      if (S.audio && document.body.contains(S.audio)) return S.audio;
      var a = document.getElementById('erius-audio');
      if (!a) {
        // 兜底：组件渲染早于 Dashboard 的 <audio> 时自建（同样带 persist 属性）
        a = document.createElement('audio');
        a.id = 'erius-audio';
        a.preload = 'none';
        a.setAttribute('data-astro-transition-persist', 'erius-audio');
        document.body.appendChild(a);
      }
      S.audio = a;
      return a;
    }

    // 统一"文件键"：解码后的 basename（audio.src 是编码 URL，file 是原始中文名）
    function baseKey(u) {
      var s = String(u || '');
      try { s = decodeURIComponent(s); } catch (e) {}
      return (s.split('/').pop() || '').toLowerCase();
    }
    function idxOfSrc(src) {
      var k = baseKey(src);
      if (!k) return -1;
      for (var i = 0; i < S.songs.length; i++) {
        if (baseKey(S.songs[i].file) === k) return i;
      }
      return -1;
    }
    function fmt(s) {
      if (!isFinite(s) || s < 0) return '0:00';
      var m = Math.floor(s / 60);
      var r = Math.floor(s % 60);
      return m + ':' + String(r).padStart(2, '0');
    }

    // 播放核心（模块级定义，audio 事件与按钮共用）
    function playSrc(i) {
      if (!S.songs.length) return;
      if (i < 0 || i >= S.songs.length) i = 0;
      var token = ++S.reqToken;   // 竞态令牌：只有最新一次切歌请求允许改按钮态
      S.idx = i;
      var a = ensureAudio();
      a.src = S.songs[i].file;
      rememberLast(S.songs[i].file);   // 预热：记住最近播放 → 下次进站先预热它
      var ui = S.ui;
      if (ui) {
        ui.nameEl.textContent = S.songs[i].name;
        ui.seekEl.value = '0';
        ui.timeEl.textContent = '加载中…';   // 诚实反馈缓冲状态，不再是假 0:00
      }
      setPlayIcon('loading');                // ⏳ 而非 ⏸：让用户知道正在缓冲
      var p = a.play();
      if (p && p.catch) p.catch(function () {
        // 仅最新请求可回退按钮；旧请求被 abort 时不覆盖新状态
        if (token === S.reqToken) setPlayIcon('play');
      });
    }
    function pickRandom() {
      if (!S.songs.length) return;
      if (S.songs.length === 1) { playSrc(0); return; }
      var cur = (S.idx >= 0 && S.idx < S.songs.length) ? S.idx : idxOfSrc(ensureAudio().src);
      // 从未播过（cur 无效）→ 直接随机任意一首；否则排除当前歌
      if (!(cur >= 0 && cur < S.songs.length)) { playSrc(Math.floor(Math.random() * S.songs.length)); return; }
      var i = cur;
      var guard = 0;
      while (i === cur && guard++ < 100) i = Math.floor(Math.random() * S.songs.length);
      playSrc(i);
    }
    function pickPrev() {
      if (!S.songs.length) return;
      var cur = (S.idx >= 0 && S.idx < S.songs.length) ? S.idx : idxOfSrc(ensureAudio().src);
      if (!(cur >= 0 && cur < S.songs.length)) { playSrc(0); return; }
      playSrc(cur <= 0 ? S.songs.length - 1 : cur - 1);
    }
    function togglePlay() {
      if (!S.songs.length) return;
      var a = ensureAudio();
      if (!a.src) { pickRandom(); return; }   // 从未选歌：先随机起播
      if (a.paused) {
        var p = a.play();
        if (p && p.catch) p.catch(function () { setPlayIcon('play'); });
        setPlayIcon('pause');
      } else {
        a.pause();
        setPlayIcon('play');
      }
    }
    function setPlayIcon(state) {
      if (!S.ui) return;
      if (state === 'loading') { S.ui.playBtn.textContent = '⏳'; return; }  // 缓冲/切歌中
      S.ui.playBtn.textContent = state === 'pause' ? '⏸' : '▶';
    }
    function syncUIFromAudio() {
      var ui = S.ui, a = ensureAudio();
      if (!ui) return;
      if (a.src) {
        ui.nameEl.textContent = idxOfSrc(a.src) >= 0 ? S.songs[idxOfSrc(a.src)].name : nameFallback(a.src);
        S.idx = idxOfSrc(a.src);
      }
      ui.playBtn.textContent = a.paused ? '▶' : '⏸';
      if (isFinite(a.duration) && a.duration > 0) {
        ui.seekEl.value = String(Math.floor((a.currentTime / a.duration) * 1000));
        ui.timeEl.textContent = fmt(a.currentTime) + ' / ' + fmt(a.duration);
      } else {
        ui.seekEl.value = '0';
        ui.timeEl.textContent = '0:00 / 0:00';
      }
    }
    function nameFallback(src) {
      var b = baseKey(src).replace(/\.(mp3|m4a|ogg|wav|aac|flac)$/i, '');
      return b || '未知曲目';
    }

    // ---------- 本地预热（建议4）：首屏后静默预取目标歌前 1MB → 起播/切歌少等待 ----------
    // 背景：GitHub Pages 国内 ~0.13MB/s，3MB 的歌切过去要等 10~25s 才出声。
    // 做法：页面空闲后 fetch Range 前 1MB 填充浏览器 HTTP 缓存；mp3/m4a 元数据都在
    // 文件头，起播时先读已缓存段 → 立即出声，剩余边播边下。不点播放则零打扰。
    function rememberLast(file) {
      try { localStorage.setItem('erius-mp-last', file); } catch (e) {}
    }
    function lastPlayed() {
      try { return localStorage.getItem('erius-mp-last') || ''; } catch (e) { return ''; }
    }
    function warmUp() {
      try {
        if (document.hidden) return;              // 后台标签不抢带宽
        if (S.audio && S.audio.src) return;       // 已在播/已选歌 → 无需预热
        var target = lastPlayed(), found = -1;
        if (target) {
          for (var i = 0; i < S.songs.length; i++) {
            if (S.songs[i].file === target) { found = i; break; }
          }
        }
        if (found < 0) found = 0;                 // 无播放记录 → 预热第一首
        var file = S.songs[found] && S.songs[found].file;
        if (!file) return;
        setTimeout(function () {                 // 延迟到首屏渲染完再拉，避免竞争
          fetch(file, { headers: { Range: 'bytes=0-1048575' }, signal: AbortSignal.timeout(60000) })
            .then(function (r) { if (r.ok) return r.blob(); })  // 读完 1MB 即进 HTTP 缓存
            .catch(function () { /* 预热失败静默忽略 */ });
        }, 2000);
      } catch (e) { /* ignore */ }
    }

    // ---------- audio 全局事件：只绑一次（audio 跨页常驻，防累积） ----------
    if (!S.bound) {
      S.bound = true;
      ensureAudio().addEventListener('timeupdate', function () {
        var ui = S.ui, a = S.audio;
        if (!ui || !a) return;
        if (!isFinite(a.duration) || a.duration <= 0) { ui.timeEl.textContent = '0:00 / 0:00'; ui.seekEl.value = '0'; return; }
        if (ui.seekEl.dataset.dragging === '1') return;   // 拖动中不回写
        ui.seekEl.value = String(Math.floor((a.currentTime / a.duration) * 1000));
        ui.timeEl.textContent = fmt(a.currentTime) + ' / ' + fmt(a.duration);
      });
      ensureAudio().addEventListener('play',     function () { setPlayIcon('pause'); });
      ensureAudio().addEventListener('playing',  function () { setPlayIcon('pause'); });
      ensureAudio().addEventListener('pause',    function () { setPlayIcon('play'); });
      ensureAudio().addEventListener('waiting',  function () { setPlayIcon('loading'); });  // 缓冲不足
      ensureAudio().addEventListener('loadedmetadata', syncUIFromAudio);
      ensureAudio().addEventListener('ended', pickRandom);   // 单曲播完自动随机下一首
    }

    // ---------- boot：绑定当前页 UI（同一 DOM 只初始化一次） ----------
    function boot() {
      var root = document.getElementById('mp-ui');
      if (!root) return;
      if (root.dataset.booted) return;   // ★ 防同一 DOM 重复初始化（page-load + inline 双触发）
      root.dataset.booted = '1';

      var isFloat = root.dataset.mode === 'float';
      var songs = JSON.parse(root.dataset.songs || '[]');
      S.songs = songs;   // 播放核心读这份列表

      var nameEl  = root.querySelector('[data-role="name"]');
      var timeEl  = root.querySelector('[data-role="time"]');
      var seekEl  = root.querySelector('[data-role="seek"]');
      var playBtn = root.querySelector('[data-role="play"]');
      var prevBtn = root.querySelector('[data-role="prev"]');
      var nextBtn = root.querySelector('[data-role="next"]');
      if (!playBtn || !seekEl) return;

      S.ui = { nameEl: nameEl, timeEl: timeEl, seekEl: seekEl, playBtn: playBtn };

      // 按钮（只绑当前 DOM 一次）
      playBtn.addEventListener('click', togglePlay);
      prevBtn.addEventListener('click', pickPrev);
      nextBtn.addEventListener('click', pickRandom);

      // seek：拖动期间不回写；input 前校验 duration（防 NaN 卡死；缓冲未完不打断加载）
      seekEl.addEventListener('pointerdown', function () { seekEl.dataset.dragging = '1'; });
      seekEl.addEventListener('pointerup',   function () { seekEl.dataset.dragging = '0'; });
      seekEl.addEventListener('input', function () {
        var a = ensureAudio();
        if (!isFinite(a.duration) || a.duration <= 0) return;  // metadata 未就绪：忽略，绝不 load() 重置加载
        a.currentTime = (Number(seekEl.value) / 1000) * a.duration;
      });

      // 从常驻 audio 恢复 UI（切页/刷新后播放状态不丢）
      syncUIFromAudio();

      // 本地预热：无播放记录时预取目标歌前 1MB，起播少等待
      warmUp();

      if (isFloat) {
        var grip = root.querySelector('[data-role="grip"]');
        var rz = root.querySelector('[data-role="resize"]');
        var saved = null;
        try { saved = JSON.parse(localStorage.getItem('erius-mp-pos') || 'null'); } catch (e) {}
        if (saved) {
          root.style.left = saved.left + 'px';
          root.style.top  = saved.top  + 'px';
          root.style.width = saved.w   + 'px';
        }
        function savePos() {
          try {
            localStorage.setItem('erius-mp-pos', JSON.stringify({
              left: root.offsetLeft, top: root.offsetTop, w: root.offsetWidth
            }));
          } catch (e) {}
        }
        var act = null, sx = 0, sy = 0, ow = 0, ox = 0, oy = 0;
        var clamp = function (v, mn, mx) { return Math.min(mx, Math.max(mn, v)); };
        grip.addEventListener('pointerdown', function (e) {
          e.preventDefault(); act = 'drag';
          sx = e.clientX; sy = e.clientY; ox = root.offsetLeft; oy = root.offsetTop;
          root.setPointerCapture(e.pointerId);
        });
        rz.addEventListener('pointerdown', function (e) {
          e.preventDefault(); e.stopPropagation(); act = 'resize';
          sx = e.clientX; sy = e.clientY; ow = root.offsetWidth;
          root.setPointerCapture(e.pointerId);
        });
        window.addEventListener('pointermove', function (e) {
          if (act === 'drag') {
            root.style.left = clamp(ox + e.clientX - sx, -root.offsetWidth + 60, innerWidth - 40) + 'px';
            root.style.top  = clamp(oy + e.clientY - sy, 8, innerHeight - 40) + 'px';
          } else if (act === 'resize') {
            root.style.width = clamp(ow + (e.clientX - sx), 150, 420) + 'px';
          }
        });
        window.addEventListener('pointerup', function () {
          if (act) { act = null; savePos(); }
        });
      }
    }

    // 初次加载：等 DOM 就绪后 boot（此时 Dashboard 的 persist <audio> 已可复用）
    function tryBoot() {
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
      else boot();
    }
    tryBoot();
    document.addEventListener('astro:page-load', boot);
  })();
</script>
