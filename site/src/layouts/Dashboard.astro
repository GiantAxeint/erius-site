---
// Dashboard 布局：公共 head + 顶部导航（所有页共享）+ 内容插槽
// 顶栏含：品牌 + 菜单（近期文章/我的项目/关于我）+ 名片/门户入口
import '../styles/global.css';
import { menuItems } from '../data/profile';
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Erius — AI grad student, Obsidian plugin maker, agent tinkerer. Regain lost courage!" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='48' fill='%2335bfab'/%3E%3Ctext x='50' y='72' font-size='60' text-anchor='middle' fill='white'%3EE%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.cn" />
  <link rel="preconnect" href="https://fonts.gstatic.cn" crossorigin />
  <link href="https://fonts.googleapis.cn/css2?family=Caveat:wght@400;500;600;700&family=Kalam:wght@300;400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="topbar">
    <a class="brand hand" href="/">Erius</a>
    <nav class="main-nav">
      {menuItems.map(item => (
        <a
          href={item.href}
          class:list={[{ 'nav-active': path.startsWith(item.href) }]}
        >{item.label}</a>
      ))}
      <span class="nav-sep"></span>
      <a href="/home" class:list={[{ 'nav-active': path === '/home' }]}>门户</a>
      <a href="/">名片</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer class="foot">
    <span>© 2026 Erius · Regain lost courage!</span>
  </footer>
</body>
</html>

<style>
  .topbar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px 16px;
    max-width: 1280px; margin: 0 auto 20px; padding: 10px 6px;
  }
  .brand { font-size: 1.8rem; }
  .main-nav { display: flex; align-items: center; gap: 14px; font-size: 1rem; flex-wrap: wrap; }
  .main-nav a { color: var(--color-primary); opacity: .65; padding: 2px 2px; }
  .main-nav a:hover { opacity: 1; }
  .main-nav a.nav-active { opacity: 1; color: var(--color-brand); font-weight: 600; }
  .nav-sep { width: 1px; height: 16px; background: var(--color-secondary); opacity: .4; }
  .foot {
    max-width: 1280px; margin: 26px auto 0; text-align: center;
    color: var(--color-secondary); font-size: 0.9rem;
  }
  @media (max-width: 560px) {
    .topbar { flex-direction: column; align-items: flex-start; }
  }
</style>
