---
// Dashboard 布局：公共 head + 顶部导航（所有页共享）+ 内容插槽
// 顶栏含：返回按钮（子页显示）+ 品牌 + 菜单
// 返回按钮：访问子页（/about /projects /tinkering /journal /404）时左上角显示，点击回 /home
// 全局能力：
//   1) <ClientRouter /> —— Astro View Transitions：子页面间切换不整页刷新
//   2) <audio id="erius-audio" transition:persist> —— 全局常驻播放器内核，
//      换页时 DOM 被保留 → 歌曲持续播放不中断（配合 MusicPlayerCard 的 UI 使用）
//   3) 子页自动注入 <MusicPlayerCard mode="float" /> —— 右下角悬浮、可拖拽/缩放；
//      主页（/home）的播放器以内嵌 docked 形态由 home.astro 自行渲染
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { menuItems } from '../data/profile';
import NavIcon from '../components/NavIcon.astro';
import MusicPlayerCard from '../components/MusicPlayerCard.astro';
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
// 是否在主页门户（主页不显示返回按钮）
const isHome = path === '/home' || path === '/home/' || path === '/home/index.html';
const isSubPage = !isHome && path !== '/' && path !== '/index.html';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <ClientRouter />
  <meta name="description" content="Erius — AI grad student, Obsidian plugin maker, agent tinkerer. Regain lost courage!" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='48' fill='%2335bfab'/%3E%3Ctext x='50' y='72' font-size='60' text-anchor='middle' fill='white'%3EE%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.cn" />
  <link rel="preconnect" href="https://fonts.gstatic.cn" crossorigin />
  <link href="https://fonts.googleapis.cn/css2?family=Caveat:wght@400;500;600;700&family=Kalam:wght@300;400;700&family=ZCOOL+KuaiLe&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="topbar">
    <div class="top-left">
      {isSubPage && (
        <a class="back-home" href="/home" title="返回主页">
          <span class="back-arrow">←</span> 返回
        </a>
      )}
      <a class="brand hand" href="https://erius.dpdns.org/">Erius</a>
    </div>
    <nav class="main-nav">
      {menuItems.map(item => (
        <a
          href={item.href}
          class:list={[{ 'nav-active': path.startsWith(item.href) }]}
        >
          <NavIcon name={item.key} size={15} />
          <span>{item.label}</span>
        </a>
      ))}
      <span class="nav-sep"></span>
      <a href="/home" class:list={[{ 'nav-active': path === '/home' }]}>门户</a>
      <a href="/">名片</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer class="foot">
    <span>© 2026 Erius · Regain lost courage!</span>
  </footer>

  {/*
    全局常驻 audio —— 切子页面（View Transitions）时 transition:persist 保留该节点，
    歌曲播放不中断。所有 MusicPlayerCard（主页 docked / 子页 float）共用这一个 audio。
  */}
  <audio id="erius-audio" preload="none" transition:persist="erius-audio"></audio>
  {/*
    子页右下角悬浮播放器：/home 主页用内嵌形态（home.astro 自己渲染 docked），
    其余 Dashboard 子页（about/projects/tinkering/journal/404）自动悬浮右下角。
  */}
  {!isHome && <MusicPlayerCard mode="float" />}
</body>
</html>

<style>
  .topbar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px 16px;
    max-width: 1280px; margin: 0 auto 20px; padding: 10px 6px;
  }
  .top-left { display: flex; align-items: center; gap: 12px; }
  .brand { font-size: 1.8rem; }
  /* 返回主页按钮（子页左上角） */
  .back-home {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 6px 14px 6px 10px;
    border: 2px solid var(--color-brand);
    border-radius: 999px;
    color: var(--color-brand);
    font-size: 0.95rem;
    line-height: 1;
    transition: all .18s;
    white-space: nowrap;
  }
  .back-home:hover {
    background: var(--color-brand); color: #fff; text-decoration: none;
  }
  .back-arrow { font-size: 1.1rem; }
  .main-nav { display: flex; align-items: center; gap: 14px; font-size: 1rem; flex-wrap: wrap; }
  .main-nav a { color: var(--color-primary); opacity: .65; padding: 2px 2px; display: inline-flex; align-items: center; gap: 5px; }
  .main-nav a svg { flex-shrink: 0; }
  .main-nav a:hover { opacity: 1; }
  .main-nav a.nav-active { opacity: 1; color: var(--color-brand); font-weight: 600; }
  .nav-sep { width: 1px; height: 16px; background: var(--color-secondary); opacity: .4; }
  .foot {
    max-width: 1280px; margin: 26px auto 0; text-align: center;
    color: var(--color-secondary); font-size: 0.9rem;
  }
  @media (max-width: 700px) {
    .topbar { flex-direction: column; align-items: stretch; }
    .top-left { justify-content: space-between; }
    .main-nav { justify-content: flex-start; overflow-x: auto; padding-bottom: 4px; }
  }
</style>
